# ============================================================
# Shaxsiy AI yordamchi bot — sozlamalar
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
# ============================================================

# BotFather'dan olingan bot tokeni (@BotFather -> /newbot)
BOT_TOKEN=123456:ABC-DEF...

# Sizning Telegram ID raqamingiz (raqam!). Bilmasangiz — @userinfobot ga
# yozing, u ID'ingizni aytadi. Faqat shu ID bot komandalarini boshqara oladi.
OWNER_ID=0

# Google Gemini API kaliti. Olish: https://aistudio.google.com/apikey
# (Google akkaunt bilan kiring -> "Create API key" -> nusxalang). Tekin tier bor.
GEMINI_API_KEY=

# Ishlatiladigan Gemini modeli (botning /settings menyusidan ham o'zgartirsa bo'ladi)
GEMINI_MODEL=gemini-flash-latest

# TTS (matn -> ovoz) provayderi. Hozircha: edge
# Keyinchalik ElevenLabs qo'shilsa: elevenlabs
TTS_PROVIDER=edge

# STT (ovoz -> matn) provayderi. Hozircha: gemini
STT_PROVIDER=gemini

# Baza fayli joylashuvi (odatda o'zgartirish shart emas)
# DB_PATH=data/bot.db
